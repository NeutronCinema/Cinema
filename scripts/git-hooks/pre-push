#!/usr/bin/env bash
# Cinema pre-push hook: run the test suite before every push.
#
# Activate once per clone:   git config core.hooksPath scripts/git-hooks
# Skip for a single push:    git push --no-verify
#
# Runs the same checks as `cimbuild -t`, minus the rebuild - the fast tier
# of the three-tier test scheme (see src/pythontests/conftest.py):
#   1. ctest  - C++ unit tests (build tree in cinemabin/)
#   2. pytest - python suite in src/pythontests (--forked), unmarked tests
#      only (< ~50 ms bodies). 'medium'-marked (50 ms - 0.7 s) tests are added
#      by `cimbuild -tt`, 'slow'-marked (> 0.7 s: real simulations, plotting,
#      CLI round-trips) only by `cimbuild -ttt`.
# See the wiki, install.md "Running the test suite", for the tier scheme.
# NOTE: no `set -u` here - sourcing env.sh pulls in install.sh, which reads
# variables it never defines and would abort the hook under nounset.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# the tests only run in a sourced environment (PYTHONPATH/LD_LIBRARY_PATH)
# shellcheck disable=SC1091
if ! source "$ROOT/env.sh" >/dev/null 2>&1; then
    echo "pre-push: cannot source env.sh - bootstrap once with '. env.sh', then retry." >&2
    exit 1
fi

# env.sh exports NCRYSTAL_PLUGIN_LIST with a trailing ';' and NCrystal aborts
# on it (install.md section 6); normalise before anything loads NCrystal.
export NCRYSTAL_PLUGIN_LIST="${NCRYSTAL_PLUGIN_LIST%;}"

status=0

if [ -f "$ROOT/cinemabin/CTestTestfile.cmake" ]; then
    echo "==> ctest (C++ unit tests)"
    # the single 'python-tests' ctest entry runs the full pytest suite; the
    # hook runs pytest itself (fast tier) below, so skip it here.
    excl='^python-tests$'
    ( cd "$ROOT/cinemabin" && ctest -j"$(( $(nproc 2>/dev/null || echo 4) / 2 ))" -E "$excl" --output-on-failure ) || status=1
else
    echo "==> ctest skipped (no build tree in cinemabin/ - run 'cimbuild -r' first)"
fi

PY="$ROOT/cinemavirenv/bin/python3"
if [ -x "$PY" ]; then
    if "$PY" -c 'import pytest, pytest_forked' >/dev/null 2>&1; then
        echo "==> pytest src/pythontests (fast tier; medium/slow tiers run in cimbuild -tt/-ttt)"
        ( cd "$ROOT/cinemabin" && "$PY" -m pytest "$ROOT/src/pythontests" --forked --tb=line -q -m "not medium and not slow" ) || status=1
    else
        echo "pre-push: pytest is missing from cinemavirenv - install it with:" >&2
        echo "    $PY -m pip install pytest pytest-forked" >&2
        exit 1
    fi
else
    echo "==> pytest skipped (no cinemavirenv - conda install?)"
fi

if [ "$status" -ne 0 ]; then
    echo ""
    echo "pre-push: tests FAILED - push aborted."
    echo "          bypass this once with: git push --no-verify"
    exit 1
fi
echo "pre-push: all tests passed."
exit 0
