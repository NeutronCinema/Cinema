DEFINE INSTRUMENT bl9_guide (
)
/********************************************************************************
* The following line is necessary for mcrun to find all the libraried needed.
* Must be modified accordingly to path of installation.
********************************************************************************/
DEPENDENCY "-lkdsource -lmcpl -lm -I<KDSource-install-prefix>/include -L<KDSource-install-prefix>/lib"
DECLARE 
%{
int DistSrcDet = 1;
double E_min = 0.1;
double E_max = 1E+07;
int ude_kde = 1;
int loop = 1;
%}

INITIALIZE 
%{
// Start of initialize for generated kds_instrument_example
%}

TRACE 
COMPONENT origin = Arm()
AT (0,0,0) ABSOLUTE

// Checked origin as (0,0,0)
COMPONENT source = KDSource(
 sourcefile = "<bl9-scripts-dir>/source/source.xml", use_kde = 1,
 loop = 1)
AT (0,0,0) RELATIVE origin

%include "guide_channels.instr"

FINALLY 
%{
// Start of finally for generated kds_instrument_example
%}

END
