<?xml version='1.0' encoding='utf-8'?>
<gdml>

    <userinfo>
      <!-- <auxiliary auxtype="PrimaryGun" auxvalue="IsotropicGun;Neutron;0.001; 0.0,0.0,0.0; 0,0,1" /> -->
    </userinfo>

    <define>
    </define>

    <materials>
        <material name="Vacuum">
          <atom value="vacuum.ncmat"/>
        </material>

        <material name="Cd">
          <atom value="Cd.ncmat"/>
        </material>
    </materials>

    <solids>
        <!-- <box lunit="mm" name="WorldSolid" x="150.0" y="150.0" z="150.0" /> -->
        <orb lunit="mm" name="OrbSolid" r="50" />
    </solids>

    <structure>
        <volume name="VolOrb">
            <solidref ref="OrbSolid" />
            <materialref ref="Vacuum" />
        </volume>

        <!-- <volume name="VolWorld">
            <solidref ref="WorldSolid" />
            <materialref ref="Cd" />

            <physvol name="PhysVol_Orb">
                <volumeref ref="VolOrb" />
                <position name="Position" unit="mm" x="0.0" y="0.0" z="0.0" />
            </physvol>
        </volume> -->
    </structure>

    <setup name="Default" version="1.0">
        <world ref="VolOrb" />
    </setup>
</gdml>
